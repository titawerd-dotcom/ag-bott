# ==========================================
# DISCORD BOT ENVIRONMENT VARIABLES
# ==========================================

# Bot Token from Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Application / Client ID from Discord Developer Portal -> General Information
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Optional: Guild ID for instant Slash Command updates during development.
# Leave empty to register commands globally across all servers (takes a few seconds/minutes to cache globally).
GUILD_ID=
